includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        analyse:
            - src/Tests/*
            - tests/*

    inferPrivatePropertyTypeFromConstructor: true
    treatPhpDocTypesAsCertain: false
    ignoreErrors: []
