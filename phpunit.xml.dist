<?xml version="1.0" encoding="UTF-8"?>

<phpunit bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="DEM-Reader Tests">
            <directory suffix="Test.php">./src/Tests/</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="xdebug.mode" value="coverage"/>
    </php>
    <logging>
        <log type="coverage-html" target="coverage-html" title="DEM Reader Coverage" charset="UTF-8" yui="true" highlight="true"/>
        <log type="coverage-clover" target="coverage.clover"/>
        <log type="coverage-xml" target="coverage.xml"/>
    </logging>
</phpunit>
