{
  "name": "runalyze/dem-reader",
  "description": "Read digital elevation files such as GeoTIFF files for srtm data or similar.",
  "version": "1.2.0",
  "license": "MIT",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0 || ^10.0 || ^11.0",
    "friendsofphp/php-cs-fixer": "^3.2",
    "phpstan/phpstan": "^1.10",
    "rector/rector": "^1.0",
    "nette/utils": "^4.0",
    "phpunit/php-code-coverage": "^9.0 || ^10.0 || ^11.0",
    "phpunit/php-invoker": "^3.1 || ^4.0"
  },
  "config": {
    "platform-check": false,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Runalyze\\DEM\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-clover=coverage.clover --coverage-xml=coverage.xml --coverage-html=coverage-html",
    "analyse": "phpstan analyse src --level=5",
    "fix": "php-cs-fixer fix",
    "rector": "rector process src --dry-run"
  }
}
